{
  "name": "gagaku-extension",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "packageManager": "bun@1.3.14",
  "license": "ISC",
  "author": "",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && bun build ./src/bundle.ts --target=browser --format=esm --minify --reject-unresolved --outfile=./dist/bundle.js",
    "watch": "bun run typecheck && bun build ./src/bundle.ts --target=browser --format=esm --minify --reject-unresolved --watch --outfile=./dist/bundle.js",
    "deploy": "bun run build && bun -e \"await Bun.write('../assets/extensionhost/bundle.js', Bun.file('./dist/bundle.js'))\""
  },
  "dependencies": {
    "@paperback/types": "1.0.0-alpha.92",
    "entities": "^8.0.0",
    "md5": "^2.3.0"
  },
  "devDependencies": {
    "@types/md5": "^2.3.6",
    "typescript": "^6.0.3"
  }
}
